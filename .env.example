# Local Ollama chat model
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=llama3.1:latest

# Hybrid retrieval. BAAI/bge-m3 runs locally on CPU unless overridden.
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DEVICE=cpu
HF_HOME=D:/tool/model-cache/customer-support

# Optional cross-encoder reranking. Enabling this downloads model weights.
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# Optional LangSmith tracing/evaluation. Not needed for local graph startup.
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGSMITH_PROJECT=customer-support-demo
